# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/soul_registry?schema=public"

# App
NODE_ENV="development"
PORT=3000

# Observability
ENABLE_METRICS="false"

# Adapters Configuration

# Notification Adapter (console | email | slack | noop)
NOTIFICATION_ADAPTER="console"
EMAIL_API_KEY=""
FROM_EMAIL=""
SLACK_WEBHOOK_URL=""
SLACK_CHANNEL=""

# Storage Adapter (local | s3 | noop)
STORAGE_ADAPTER="local"
UPLOAD_PATH="./uploads"
S3_BUCKET=""
S3_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Analytics Adapter (console | segment | mixpanel | noop)
ANALYTICS_ADAPTER="console"
SEGMENT_WRITE_KEY=""
MIXPANEL_TOKEN=""

# Optional: External Auth System Integration
AUTH_SERVICE_URL="http://localhost:3001"
AUTH_API_KEY="your-auth-api-key"
