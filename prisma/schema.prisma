// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Core member information
model MemberCore {
  id            String   @id @default(cuid())
  externalId    String   @unique // From external auth system
  displayName   String
  avatarUrl     String?
  joinedAt      DateTime @default(now())
  primaryEmail  String   @unique
  metaJson      Json?    // Flexible metadata storage
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  soulProfile         SoulProfile?
  preferenceProfile   PreferenceProfile?
  participationStats  ParticipationStats?
  tags                TagAttachment[]
  history             MemberHistory[]
  profileSnapshots    ProfileSnapshot[]
  engagementEvents    EngagementEvent[]
  cohortMemberships   CohortMembership[]
  relationshipsFrom   MemberRelationship[] @relation("RelationshipFrom")
  relationshipsTo     MemberRelationship[] @relation("RelationshipTo")

  @@index([externalId])
  @@index([primaryEmail])
  @@map("member_cores")
}

// Soul profile capturing values, archetypes, and life stage
model SoulProfile {
  id                 String   @id @default(cuid())
  memberId           String   @unique
  lifeStage          LifeStage @default(SEEDLING)
  primaryArchetype   String   // e.g., "The Builder", "The Sage", "The Connector"
  secondaryArchetype String?
  valuesJson         Json     // Array of values: ["curiosity", "growth", "community"]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  member MemberCore @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([lifeStage])
  @@map("soul_profiles")
}

enum LifeStage {
  SEEDLING  // New member, exploring
  GROWING   // Active participant, learning
  MENTOR    // Experienced, helping others
  ELDER     // Long-term, wisdom keeper
}

// Interaction and content preferences
model PreferenceProfile {
  id                    String   @id @default(cuid())
  memberId              String   @unique
  interactionStyle      InteractionStyle @default(ACTIVE)
  contentFormatPrefsJson Json?   // Preferences: video, text, audio, interactive
  availabilityJson      Json?    // Timezone, preferred times, frequency
  updatedAt             DateTime @updatedAt

  // Relations
  member MemberCore @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("preference_profiles")
}

enum InteractionStyle {
  QUIET  // Prefers observing, occasional participation
  ACTIVE // Regular engagement, comments, posts
  DEEP   // Long-form discussions, detailed contributions
  FAST   // Quick interactions, brief responses
}

// Participation metrics and engagement stats
model ParticipationStats {
  id                    String   @id @default(cuid())
  memberId              String   @unique
  totalSessionsAttended Int      @default(0)
  totalMessagesPosted   Int      @default(0)
  totalQuestsCompleted  Int      @default(0)
  lastActiveAt          DateTime @default(now())
  streakDays            Int      @default(0)
  metaJson              Json?    // Additional custom metrics
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  member MemberCore @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([lastActiveAt])
  @@map("participation_stats")
}

// Flexible tagging system for categorization
model TagAttachment {
  id        String    @id @default(cuid())
  memberId  String
  tag       String    // e.g., "quiet-regular", "mentor-potential", "burst-type"
  source    TagSource @default(SYSTEM)
  createdAt DateTime  @default(now())

  // Relations
  member MemberCore @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, tag])
  @@index([memberId])
  @@index([tag])
  @@map("tag_attachments")
}

enum TagSource {
  SYSTEM // Auto-generated by heuristics
  MENTOR // Applied by mentors/admins
  SELF   // Self-assigned by member
}

// Track significant life events and milestones
model MemberHistory {
  id          String          @id @default(cuid())
  memberId    String
  eventType   HistoryEventType
  title       String
  description String?
  metadata    Json?           // Additional context
  occurredAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())

  // Relations
  member MemberCore @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([eventType])
  @@index([occurredAt])
  @@map("member_histories")
}

enum HistoryEventType {
  JOINED             // Member joined the community
  LIFE_STAGE_CHANGE  // Progressed to new life stage
  ARCHETYPE_CHANGE   // Changed primary archetype
  MILESTONE_REACHED  // Achieved a milestone
  QUEST_COMPLETED    // Completed a significant quest
  MENTOR_ASSIGNED    // Became a mentor or got a mentor
  ACHIEVEMENT_EARNED // Earned an achievement/badge
  CUSTOM             // Custom event
}

// Periodic snapshots of soul profiles for change tracking
model ProfileSnapshot {
  id                 String    @id @default(cuid())
  memberId           String
  lifeStage          LifeStage
  primaryArchetype   String
  secondaryArchetype String?
  valuesJson         Json
  statsSnapshot      Json      // ParticipationStats at time of snapshot
  tagsSnapshot       Json      // Tags at time of snapshot
  snapshotReason     String?   // Why this snapshot was taken
  createdAt          DateTime  @default(now())

  // Relations
  member MemberCore @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([createdAt])
  @@map("profile_snapshots")
}

// Detailed event log for all engagement activities
model EngagementEvent {
  id             String           @id @default(cuid())
  memberId       String
  eventType      EngagementEventType
  sessionId      String?          // If part of a session
  questId        String?          // If related to a quest
  relatedMemberId String?         // If involves another member
  duration       Int?             // Duration in seconds
  metadata       Json?            // Rich event context
  occurredAt     DateTime         @default(now())

  // Relations
  member MemberCore @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([eventType])
  @@index([occurredAt])
  @@index([sessionId])
  @@map("engagement_events")
}

enum EngagementEventType {
  SESSION_ATTENDED
  MESSAGE_POSTED
  QUEST_STARTED
  QUEST_COMPLETED
  QUEST_ABANDONED
  PEER_HELPED
  MENTOR_SESSION
  CONTENT_CREATED
  CONTENT_CONSUMED
  REACTION_GIVEN
  COMMENT_POSTED
}

// Groups for cohort-based operations
model Cohort {
  id          String    @id @default(cuid())
  name        String
  description String?
  criteria    Json?     // Auto-assignment criteria
  metadata    Json?     // Additional cohort data
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  memberships CohortMembership[]

  @@index([isActive])
  @@index([createdAt])
  @@map("cohorts")
}

// Many-to-many relationship between members and cohorts
model CohortMembership {
  id         String    @id @default(cuid())
  cohortId   String
  memberId   String
  joinedAt   DateTime  @default(now())
  leftAt     DateTime?
  metadata   Json?     // Membership-specific data

  // Relations
  cohort Cohort      @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  member MemberCore  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([cohortId, memberId])
  @@index([cohortId])
  @@index([memberId])
  @@map("cohort_memberships")
}

// Member-to-member relationships
model MemberRelationship {
  id               String            @id @default(cuid())
  fromMemberId     String
  toMemberId       String
  relationshipType RelationshipType
  strength         Int               @default(1) // 1-10 relationship strength
  status           RelationshipStatus @default(ACTIVE)
  metadata         Json?
  establishedAt    DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relations
  fromMember MemberCore @relation("RelationshipFrom", fields: [fromMemberId], references: [id], onDelete: Cascade)
  toMember   MemberCore @relation("RelationshipTo", fields: [toMemberId], references: [id], onDelete: Cascade)

  @@unique([fromMemberId, toMemberId, relationshipType])
  @@index([fromMemberId])
  @@index([toMemberId])
  @@index([relationshipType])
  @@map("member_relationships")
}

enum RelationshipType {
  MENTOR_MENTEE   // Mentorship relationship
  PEER            // Peer collaboration
  STUDY_BUDDY     // Learning partnership
  PROJECT_TEAM    // Project collaboration
  SIMILAR_VALUES  // Algorithmically matched by values
  CUSTOM          // Custom relationship type
}

enum RelationshipStatus {
  PENDING   // Relationship proposed but not accepted
  ACTIVE    // Active relationship
  PAUSED    // Temporarily paused
  ENDED     // Relationship ended
}
